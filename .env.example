# Existing Supabase public connection variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only: set in Vercel environment settings, then redeploy.
# When unset/empty, POS_INTERNAL_PIN falls back to the PIN requested by the owner.
POS_INTERNAL_PIN=
# Optional independent signing secret. Use a long random value; never NEXT_PUBLIC_.
POS_SESSION_SECRET=
